Prevention
Statins},
   ISSN = {1534-6242 (Electronic)
1523-3804 (Linking)},
   DOI = {10.1007/s11883-025-01342-7},
   url = {https://www.ncbi.nlm.nih.gov/pubmed/41212365},
   year = {2025},
   type = {Journal Article}
}

